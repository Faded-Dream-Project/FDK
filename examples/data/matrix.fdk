# matrix.fdk — a high-contrast green-on-black example theme for
# demo 08. Deliberately sparse: only six colors and one metric are
# overridden; everything else inherits the built-in defaults
# (partial themes are a feature, not a fallback).

version = 1
name    = "Matrix"
author  = "FDK examples"

[colors]
window_background          = #060A06
text                       = #39FF88
control_background         = #0C2412
control_background_hover   = #123618
control_background_pressed = #1A4A22
control_border             = #1E5A2C
accent                     = #7CFFA8
track                      = #08170C

[metrics]
button_corner_radius = 2
