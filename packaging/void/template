# packaging/void/template — XBPS source template for FDK.
#
# REFERENCE metadata for distro packagers building FDK with
# xbps-src from the void-packages tree. The release pipeline
# (packaging/void/build-xbps.sh) builds the same two packages with
# xbps-create directly, from this metadata — same names, versions,
# dependencies, and file layout.
#
# VERSION SPELLING: while a release candidate is in the tree the raw
# upstream version carries a hyphenated suffix ("1.1.0-rc1") that xbps
# forbids (void-packages Manual: versions "must not contain dashes or
# underscores" or special chars — a dash also makes the pkgname-version
# split ambiguous). The pipeline therefore spells package versions the
# xbps way, dropping the hyphen: 1.1.0rc1 (see fdk_packver in
# packaging/ci/common.sh). Plain releases (1.1.0) are identical to
# upstream. The same rule applies to wrksrc/distfiles below whenever
# you carry a candidate version into this template by hand.
#
# Void convention: fdk-libs (runtime) + fdk-devel (development
# files), /usr/lib as the library directory (Void uses no lib64).
#
# The static archive is deliberately NOT packaged (FDK Proprietary
# License 4(d): distributing statically-linked FDK requires separate
# written authorization).

pkgname=fdk
version=@VERSION@
revision=1
archs="x86_64"
wrksrc="fdk-${version}"
build_style="gnu-makefile"
hostmakedepends="pkgconf"
makedepends="libX11-devel libXext-devel zlib-devel wayland-devel libxkbcommon-devel"
short_desc="Faded Dream ToolKit — native C GUI toolkit for X11 and Wayland"
maintainer="FDK maintainers <https://github.com/Faded-Dream-Project/FDK>"
license="Proprietary"
homepage="https://github.com/Faded-Dream-Project/FDK"
distfiles="https://github.com/Faded-Dream-Project/FDK/releases/download/v${version}/fdk-${version}.tar.gz"
checksum=SKIP

do_build() {
        make
        make test
        make FDK_CONFIG=release all
}

do_check() {
        make test
}

do_install() {
        make FDK_CONFIG=release install DESTDIR=${DESTDIR} PREFIX=/usr LIBDIR=/usr/lib
        # The static archive is NOT shipped (license posture, see above).
        rm -f ${DESTDIR}/usr/lib/libfdk.a
        vlicense LICENSE
        vdoc THIRD-PARTY-NOTICES.md
}

fdk-libs_package() {
        short_desc+=" — runtime library and theme faces"
        pkg_install() {
                vmove "usr/lib/libfdk.so.*"
                vmove usr/share/fdk
        }
}

fdk-devel_package() {
        depends="fdk-libs-${version}_${revision}"
        short_desc+=" — development files"
        pkg_install() {
                vmove usr/include
                vmove "usr/lib/libfdk.so"
                vmove usr/lib/pkgconfig
                vmove usr/bin
        }
}
