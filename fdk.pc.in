# fdk.pc.in — pkg-config template for FDK
#
# Processed by the Makefile into build/fdk.pc at install time; the
# version comes from include/fdk/fdk_version.h (never a second
# hand-edited copy) and the dependency list from the same
# pkg-config results the build itself resolved.

prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCDIR@

Name: fdk
Description: Faded Dream ToolKit — C11 native GUI toolkit for Wayland and X11
Version: @VERSION@
URL: https://github.com/Faded-Dream-Project/FDK
Cflags: -I${includedir}
Libs: -L${libdir} -lfdk
# The .so already carries every platform dependency; a dynamically
# linked application needs NONE of them, and a plain
# `pkg-config --cflags --libs fdk` must succeed on machines without
# the X11 development packages — hence raw flags in Libs.private (used
# only by --static consumers) rather than Requires.private, whose
# package graph pkg-config resolves (and fails on) for every query.
Libs.private: @PC_LIBS@ -lm
